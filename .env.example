# Postgres connection (Render provides this automatically when using render.yaml)
DATABASE_URL=postgresql://user:password@localhost:5432/bakers_delight_radar
PORT=3000

# --- DataForSEO (dataforseo.com) -- primary Trends provider ---
# Get credentials from your DataForSEO dashboard (login is an email, not a token).
# Required for the Search demand panel; that panel shows "Awaiting connection"
# without these rather than any invented numbers.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Daily hard ceiling on DataForSEO spend (USD, sum of each task's reported
# `cost`). Ingestion stops submitting new DataForSEO tasks once this is hit
# for the day and marks the remaining topics as skipped, not failed.
DATAFORSEO_DAILY_COST_CEILING_USD=5

# --- Apify (apify.com) -- powers Reddit, TikTok and Instagram social signals ---
APIFY_TOKEN=

# Actor IDs -- override if you swap to a different actor (see README).
# APIFY_REDDIT_ACTOR_ID=trudax/reddit-scraper-lite
# APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
# APIFY_INSTAGRAM_ACTOR_ID=instaprism/instagram-hashtag-posts

# Feature flags -- each social source is independently disableable. The
# dashboard works fully with any subset off; a disabled/misconfigured source
# just shows as `awaiting_connection` on Source health instead of breaking
# the rest of the report.
FEATURE_APIFY_REDDIT=true
FEATURE_APIFY_TIKTOK=true
FEATURE_APIFY_INSTAGRAM=true

# Reddit communities to scan (comma-separated, no r/).
APIFY_REDDIT_SUBREDDITS=fitness,MealPrepSunday,budgetfood,AskAnAustralian,australia

# TikTok/Instagram search terms and hashtags -- comma-separated. Defaults to
# the active topic library's queries if unset.
# APIFY_TIKTOK_SEARCH_TERMS=
# APIFY_INSTAGRAM_HASHTAGS=

# Feature flags for panels not yet built (kept here so the schema/UI already
# knows about them -- see README "What's deferred"). Leave false.
FEATURE_LOCAL_VISIBILITY=false
FEATURE_DIGITAL_AVAILABILITY=false
FEATURE_COMPETITOR_PULSE=false
FEATURE_CUSTOMER_VOICE=false

# --- Admin ---
# Gates POST /admin/refresh (triggers an ingestion run on demand). On Render
# this is auto-generated (generateValue: true in render.yaml); set your own
# locally to test the endpoint.
ADMIN_TOKEN=
